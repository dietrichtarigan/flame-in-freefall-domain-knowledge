# ---------------------------------------------------------------------------
# Repo ini sengaja berisi LAPISAN HASIL saja, bukan arsip mentah NASA.
# Yang mentah (~15,6 GB) tidak diunggah karena bisa diunduh ulang dari NASA:
#   python scripts/psi_fetch.py        (manifest ber-checksum ada di kb/manifest/)
#   python scripts/ntrs_fetch.py
# ---------------------------------------------------------------------------

# Arsip mentah NASA (~15,6 GB: video, telemetri 125 Hz, PDF PSI)
kb/raw/

# Bobot model terlatih & tensor antara — bisa dibangun ulang dari skrip
*.pt
*.npz

# Berkas kerja sementara
.artifact_build/
.shot/
arsip/
logs/
*.part
__pycache__/
*.pyc
.venv/
venv/

# Kunci API dan rahasia lain — JANGAN pernah di-commit (.env.example boleh)
.env
.env.*
!.env.example

# Pustaka pihak ketiga yang diunduh (three.js dll) — lihat docs/ untuk cara ambil
app/vendor/

# Berkas OS
Thumbs.db
desktop.ini
.DS_Store

# Buku teks berhak cipta (bukan data NASA) — jangan didistribusikan ulang
supplement/

# Basis data mentah 101 MB melewati batas keras GitHub (100 MiB).
# Yang dilacak versi terkompresinya (34 MB); lihat README untuk membukanya.
kb/gold/freefall.sqlite

# Salinan kerja freefall.sqlite (dibuat scripts/kbpaths.py dari .gz)
kb/gold/freefall.sqlite.new
kb/gold/freefall.sqlite.tmp

# Cache indeks pencarian (dibangun ulang otomatis oleh scripts/retrieval.py)
kb/cache/
