# ---------------------------------------------------------------------------
# Repo ini sengaja berisi LAPISAN HASIL saja, bukan arsip mentah NASA.
# Yang mentah (~15,6 GB) tidak diunggah karena bisa diunduh ulang dari NASA:
#   python scripts/psi_fetch.py        (manifest ber-checksum ada di kb/manifest/)
#   python scripts/ntrs_fetch.py
# ---------------------------------------------------------------------------

# Arsip mentah NASA (~15,6 GB: video, telemetri 125 Hz, PDF PSI)
kb/raw/

# Bobot model terlatih & tensor antara — bisa dibangun ulang dari skrip
*.pt
*.npz

# Berkas kerja sementara
.artifact_build/
.shot/
arsip/
logs/
*.part
__pycache__/
*.pyc
.venv/
venv/

# Kunci API dan rahasia lain — JANGAN pernah di-commit (.env.example boleh)
.env
.env.*
!.env.example

# Pustaka pihak ketiga yang diunduh (three.js dll) — lihat docs/ untuk cara ambil
app/vendor/

# Berkas OS
Thumbs.db
desktop.ini
.DS_Store

# Buku teks berhak cipta (bukan data NASA) — jangan didistribusikan ulang
supplement/

# Basis data mentah 101 MB melewati batas keras GitHub (100 MiB).
# Yang dilacak versi terkompresinya (34 MB); lihat README untuk membukanya.
kb/gold/freefall.sqlite

# Salinan kerja freefall.sqlite (dibuat scripts/kbpaths.py dari .gz)
kb/gold/freefall.sqlite.new
kb/gold/freefall.sqlite.tmp

# Cache indeks pencarian (dibangun ulang otomatis oleh scripts/retrieval.py)
kb/cache/

# Gambar paper resolusi asli sebelum dikecilkan (419 MB) — hasil kecilnya yang dilacak
analysis/figures_orig/
analysis/figures_opt/

# Ekstraksi gambar versi lama (datar, 2.893 WebP): tidak dibaca find_figures,
# yang dipakai analysis/figures/figures.json dari paper_figures.py --from-db
analysis/figures_flat_legacy/

# Paket distribusi 27 GB (7 bagian @4 GB) — bagikan lewat drive, bukan git
deliverables/*.zip
deliverables/*.part*

# Dependensi build frontend
node_modules/
app/flare-src/node_modules/

# Dependensi build frontend (app/flare dibangun dari app/flare-src)
node_modules/

# Folder kerja sementara (tangkapan layar, cadangan)
.look/
.bak/

# Cache unduhan graf sitasi (Crossref/OpenAlex); bangun ulang: python scripts/citation_graph.py all
analysis/citations/crossref/
analysis/citations/cache/
analysis/citations/crossref.json
analysis/citations/*.log
