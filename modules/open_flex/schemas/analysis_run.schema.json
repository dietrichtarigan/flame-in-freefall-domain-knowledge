{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://open-flex.local/schemas/analysis_run.schema.json",
 "title": "AnalysisRun",
 "description": "A computation on data (e.g. a D² fit to digitized points). Inherits no NASA test identity: it references its input datasets.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "record_type",
  "run_id",
  "inputs",
  "method",
  "software",
  "outputs",
  "verification_kind"
 ],
 "properties": {
  "record_type": {
   "const": "AnalysisRun"
  },
  "run_id": {
   "$ref": "common.schema.json#/$defs/analysis_run_id"
  },
  "inputs": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "dataset_id",
     "sha256"
    ],
    "properties": {
     "dataset_id": {
      "$ref": "common.schema.json#/$defs/dataset_id"
     },
     "sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
     }
    }
   }
  },
  "about_physical_test": {
   "oneOf": [
    {
     "$ref": "common.schema.json#/$defs/physical_test_id"
    },
    {
     "type": "null"
    }
   ],
   "description": "Only when inputs are unmodified data of that test."
  },
  "method": {
   "type": "string"
  },
  "parameters": {
   "type": "object"
  },
  "software": {
   "type": "object"
  },
  "outputs": {
   "type": "object"
  },
  "verification_kind": {
   "enum": [
    "none",
    "code verification",
    "solution verification",
    "comparison with published value (not validation)"
   ]
  }
 }
}
