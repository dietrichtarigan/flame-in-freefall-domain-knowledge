{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://open-flex.local/schemas/claim.schema.json",
 "title": "Claim/evidence registry",
 "type": "object",
 "required": [
  "registry_version",
  "claims"
 ],
 "properties": {
  "registry_version": {
   "type": "string"
  },
  "fields": {
   "type": "object"
  },
  "claims": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "claim_id",
     "claim_text",
     "evidence_class",
     "sources",
     "support",
     "verification_status"
    ],
    "properties": {
     "claim_id": {
      "$ref": "common.schema.json#/$defs/claim_id"
     },
     "claim_text": {
      "type": "string",
      "minLength": 5
     },
     "evidence_class": {
      "$ref": "common.schema.json#/$defs/evidence_class"
     },
     "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
       "$ref": "common.schema.json#/$defs/source_ref"
      }
     },
     "support": {
      "enum": [
       "direct",
       "partial"
      ]
     },
     "verification_status": {
      "$ref": "common.schema.json#/$defs/verification_status"
     },
     "note": {
      "type": "string"
     }
    }
   }
  }
 }
}
