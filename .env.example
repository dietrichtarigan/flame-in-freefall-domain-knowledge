# Salin jadi ".env" di folder ini (akar repo). .env diabaikan git: JANGAN di-commit.
# Server hanya membaca baris ANTHROPIC_*, DEEPSEEK_* dan LLM_PROVIDER.

# Pilih penyedia model bahasa: deepseek atau anthropic (bawaan: anthropic)
LLM_PROVIDER=deepseek

# DeepSeek: kunci dari platform.deepseek.com. Nama variabelnya HARUS DEEPSEEK_API_KEY,
# bukan ANTHROPIC_API_KEY — kalau tidak, kuncinya bisa terkirim ke api.anthropic.com.
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-v4-pro      # atau deepseek-flash

# Anthropic (bila LLM_PROVIDER=anthropic): kunci dari console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...
